{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "lib": ["es2025"],
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "paths": {
      "@escode/contracts": ["../../../apps/escode-cli/packages/contracts/src/index.ts"],
      "@escode/dynamic-workflow": [
        "../../../apps/escode-cli/packages/dynamic-workflow/src/index.ts"
      ],
      "@escode/model-option-map": ["../../model-option-map/src/index.ts"]
    }
  },
  // 测试经相对路径 import 服务源码，program 会比 include 更宽：源码依赖的 ambient 声明
  // （yazl）不在 include 里就会报 TS7016，这里显式带上。
  "include": ["./escode-cli-rust-*.ts", "../src/types/*.d.ts"]
}
