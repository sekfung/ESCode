{
  "name": "@escode/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for escode",
  "bin": {
    "escode": "./dist/escode.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/escode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/escode-cli run build --filter=!@escode/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@escode/adapters": "workspace:*",
    "@escode/bootstrap": "workspace:*",
    "@escode/contracts": "workspace:*",
    "@escode/core": "workspace:*",
    "@escode/dynamic-workflow": "workspace:*",
    "@escode/dynamic-workflow-runtime": "workspace:*",
    "@escode/i18n": "workspace:*",
    "@escode/provider-node": "workspace:*",
    "@escode/shared": "workspace:*",
    "@escode/shared-types": "workspace:*",
    "@escode/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
