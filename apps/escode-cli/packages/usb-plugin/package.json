{
  "name": "@escode/usb-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "Official USB plugin: capture and protocol-aware decode of USB traffic (CCID smart cards, HID, MSC/SCSI) for the agent.",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --no-ignore",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "test": "vitest run test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
}
