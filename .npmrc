node-linker=hoisted
registry=https://registry.npmjs.org
; Electron 二进制不通过 npm registry 分发，@electron/get 默认从 GitHub Releases 下载。
; 这里固定为 npmmirror，使 pnpm install 的 electron postinstall 不依赖 GitHub 连通性；
; 与 mise.toml 的 [env] ELECTRON_MIRROR、packages/desktop/scripts/bundle.mjs 的默认镜像一致。
electron_mirror=https://npmmirror.com/mirrors/electron/
