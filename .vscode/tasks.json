    {
      "label": "escode: tsup watch (debug)",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/tsup-watch.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "escode-debug"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "\\[HOST\\] CLI Watching for changes in"
        }
      }
